controllers:
  saga-worker:
    containers:
      worker:
        command: ["python", "/app/worker.py"]
        env:
          PYTHONUNBUFFERED: '1'
          TEMPORAL_ADDRESS: temporal-frontend.temporal.svc.cluster.local:7233
          TEMPORAL_NAMESPACE: default
          TEMPORAL_TASK_QUEUE: saga
          PGHOST: temporal-pg-rw.temporal.svc.cluster.local
          PGDATABASE: saga
          PGUSER: temporal
          PGPASSWORD:
            valueFrom:
              secretKeyRef:
                name: temporal-pg-app
                key: password
        image:
          repository: registry.127.0.0.1.sslip.io/saga
          tag: {{ exec "python3" (list "../../scripts/images.py" "tag" "saga") | quote }}
        resources:
          limits:
            memory: 512Mi
          requests:
            cpu: 50m
            memory: 128Mi
    forceRename: saga-worker
    replicas: null
    strategy: RollingUpdate
rawResources:
  saga-worker:
    forceRename: saga-worker
    manifest:
      apiVersion: keda.sh/v1alpha1
      kind: ScaledObject
      spec:
        advanced:
          horizontalPodAutoscalerConfig:
            behavior:
              scaleDown:
                stabilizationWindowSeconds: 60
        cooldownPeriod: 60
        maxReplicaCount: 6
        minReplicaCount: 0
        pollingInterval: 15
        scaleTargetRef:
          name: saga-worker
        triggers:
        - metadata:
            activationTargetQueueSize: '0'
            endpoint: temporal-frontend.temporal.svc.cluster.local:7233
            namespace: default
            queueTypes: workflow,activity
            targetQueueSize: '5'
            taskQueue: saga
          type: temporal
