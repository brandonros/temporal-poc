configMaps:
  greeter-worker:
    data:
      worker.py: |
{{ readFile "../../apps/greeter/worker.py" | indent 8 }}
    forceRename: greeter-worker-src
    includeChecksumInControllers:
    - greeter-worker
controllers:
  greeter-worker:
    containers:
      worker:
        args:
        - pip install --no-cache-dir --quiet temporalio==1.18.1
          && exec python /app/worker.py
        command:
        - /bin/sh
        - -c
        env:
          GREET_SECONDS: '5'
          MAX_CONCURRENT_ACTIVITIES: '2'
          PYTHONUNBUFFERED: '1'
          TEMPORAL_ADDRESS: temporal-frontend.temporal.svc.cluster.local:7233
          TEMPORAL_NAMESPACE: default
          TEMPORAL_TASK_QUEUE: greeter
        image:
          repository: python
          tag: 3.12-slim
        resources:
          limits:
            memory: 512Mi
          requests:
            cpu: 50m
            memory: 128Mi
    forceRename: greeter-worker
    replicas: null
    strategy: RollingUpdate
persistence:
  greeter-worker:
    advancedMounts:
      greeter-worker:
        worker:
        - path: /app
          readOnly: true
    identifier: greeter-worker
    type: configMap
rawResources:
  greeter-worker:
    forceRename: greeter-worker
    manifest:
      apiVersion: keda.sh/v1alpha1
      kind: ScaledObject
      spec:
        advanced:
          horizontalPodAutoscalerConfig:
            behavior:
              scaleDown:
                stabilizationWindowSeconds: 60
        cooldownPeriod: 60
        maxReplicaCount: 6
        minReplicaCount: 0
        pollingInterval: 15
        scaleTargetRef:
          name: greeter-worker
        triggers:
        - metadata:
            activationTargetQueueSize: '0'
            endpoint: temporal-frontend.temporal.svc.cluster.local:7233
            namespace: default
            queueTypes: workflow,activity
            targetQueueSize: '5'
            taskQueue: greeter
          type: temporal
