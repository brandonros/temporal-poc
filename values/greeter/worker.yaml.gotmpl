controllers:
  greeter-worker:
    containers:
      worker:
        command: ["python", "/app/worker.py"]
        env:
          GREET_SECONDS: '5'
          MAX_CONCURRENT_ACTIVITIES: '2'
          PYTHONUNBUFFERED: '1'
          TEMPORAL_ADDRESS: temporal-frontend.temporal.svc.cluster.local:7233
          TEMPORAL_NAMESPACE: default
          TEMPORAL_TASK_QUEUE: greeter
        image:
          repository: registry.127.0.0.1.sslip.io/greeter
          tag: {{ exec "python3" (list "../../scripts/images.py" "tag" "greeter") | quote }}
        resources:
          limits:
            memory: 512Mi
          requests:
            cpu: 50m
            memory: 128Mi
    forceRename: greeter-worker
    replicas: null
    strategy: RollingUpdate
rawResources:
  greeter-worker:
    forceRename: greeter-worker
    manifest:
      apiVersion: keda.sh/v1alpha1
      kind: ScaledObject
      spec:
        advanced:
          horizontalPodAutoscalerConfig:
            behavior:
              scaleDown:
                stabilizationWindowSeconds: 60
        cooldownPeriod: 60
        maxReplicaCount: 6
        minReplicaCount: 0
        pollingInterval: 15
        scaleTargetRef:
          name: greeter-worker
        triggers:
        - metadata:
            activationTargetQueueSize: '0'
            endpoint: temporal-frontend.temporal.svc.cluster.local:7233
            namespace: default
            queueTypes: workflow,activity
            targetQueueSize: '5'
            taskQueue: greeter
          type: temporal
