configMaps:
  greeter-api:
    data:
      api.py: |
{{ readFile "../../apps/greeter/api.py" | indent 8 }}
    forceRename: greeter-api-src
    includeChecksumInControllers:
    - greeter-api
controllers:
  greeter-api:
    containers:
      api:
        args:
        - pip install --no-cache-dir --quiet temporalio==1.18.1 aiohttp==3.13.2 prometheus-client==0.24.1
          && exec python /app/api.py
        command:
        - /bin/sh
        - -c
        env:
          GREET_TIMEOUT_SECONDS: '180'
          PORT: '8000'
          PYTHONUNBUFFERED: '1'
          TEMPORAL_ADDRESS: temporal-frontend.temporal.svc.cluster.local:7233
          TEMPORAL_NAMESPACE: default
          TEMPORAL_TASK_QUEUE: greeter
        image:
          repository: python
          tag: 3.12-slim
        probes:
          readiness:
            custom: true
            enabled: true
            spec:
              failureThreshold: 30
              httpGet:
                path: /healthz
                port: http
              initialDelaySeconds: 20
              periodSeconds: 5
        resources:
          limits:
            memory: 512Mi
          requests:
            cpu: 50m
            memory: 128Mi
    forceRename: greeter-api
    replicas: null
    strategy: RollingUpdate
ingress:
  greeter-api:
    className: traefik
    forceRename: greeter-api
    hosts:
    - host: greeter.127.0.0.1.sslip.io
      paths:
      - path: /
        pathType: Prefix
        service:
          identifier: greeter-api
          port: http
persistence:
  greeter-api:
    advancedMounts:
      greeter-api:
        api:
        - path: /app
          readOnly: true
    identifier: greeter-api
    type: configMap
rawResources:
  greeter-api:
    forceRename: greeter-api
    manifest:
      apiVersion: keda.sh/v1alpha1
      kind: ScaledObject
      spec:
        advanced:
          horizontalPodAutoscalerConfig:
            behavior:
              scaleDown:
                stabilizationWindowSeconds: 60
        cooldownPeriod: 60
        maxReplicaCount: 5
        minReplicaCount: 1
        pollingInterval: 15
        scaleTargetRef:
          name: greeter-api
        triggers:
        - metadata:
            ignoreNullValues: 'true'
            query: sum(rate(traefik_service_requests_total{service="temporal-greeter-api-8000@kubernetes"}[1m]))
            serverAddress: http://kube-prometheus-stack-prometheus.monitoring.svc.cluster.local:9090
            threshold: '1'
          type: prometheus
service:
  greeter-api:
    controller: greeter-api
    forceRename: greeter-api
    ports:
      http:
        port: 8000
        targetPort: http
serviceMonitor:
  greeter-api:
    endpoints:
    - interval: 15s
      path: /metrics
      port: http
    forceRename: greeter-api
    serviceName: greeter-api
